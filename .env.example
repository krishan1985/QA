# ── Sigma AI Testing Agent — Environment Variables ──

# Application
APP_NAME=Sigma Testing AI Agent
APP_URL=http://localhost:3000
SECRET_KEY=change-me-to-something-secure
ENVIRONMENT=development

# ── FREE LLM (Priority: groq > ollama > gemini) ──────
LLM_PROVIDER=groq
# 1. GROQ — FREE: https://console.groq.com (instant signup, LLaMA 3.1 70B)
GROQ_API_KEY=

# 2. OLLAMA — 100% FREE local: brew install ollama && ollama pull llama3.1
OLLAMA_HOST=http://localhost:11434

# 3. GOOGLE GEMINI — FREE tier (15 req/min): https://aistudio.google.com
GOOGLE_API_KEY=

# ── Optional Paid LLMs ────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── FREE Search ───────────────────────────────────────
# SerpAPI: 100 free searches/month at https://serpapi.com
SERP_API_KEY=

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://sigma:password@localhost:5432/sigma_db
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=sigma-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# ── Email ──────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# ── Stripe (optional subscription) ───────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# ── Service Ports ─────────────────────────────────────
AI_CORE_PORT=8000
LLM_ENGINE_PORT=8001
CRAWLER_PORT=8002
EXECUTOR_PORT=8003
FRONTEND_PORT=3000
